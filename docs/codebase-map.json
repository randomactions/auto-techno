      "id": "main-actor-presentation",
      "name": "MainActor presentation",
      "ownerComponent": "read-only-ui-and-presentation",
      "executionContext": "SwiftUI/AppKit MainActor presentation and bounded user transport actions.",
      "allowedWork": "Render status, waveform, time, inspector data, and dispatch play/pause or New Set intent.",
      "forbiddenWork": "Musical planning, DSP analysis, PCM mutation, callback work, or technical parameter control.",
      "failureBehavior": "Show coherent preparing/recovering/unavailable state without inventing runtime success.",
      "tests": [
        "Tests/AutoTechnoAppTests/LiveRenderInspectorTests.swift",
        "Tests/AutoTechnoAppTests/PlayingTimeTests.swift"
      ]
    },
    {
