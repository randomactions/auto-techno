      "id": "macos-realtime-production",
      "name": "macOS realtime production",
      "ownerComponent": "realtime-pcm-handoff",
      "executionContext": "AVAudioSourceNode render callback with one queue producer.",
      "allowedWork": "Bounded fixed-capacity native-stereo copy plus lock-free index/counter updates.",
      "forbiddenWork": "Allocation, locks, waits, analysis, logging, file/network I/O, UI, or musical decisions.",
      "failureBehavior": "Drop the packet, increment a fixed counter, and continue audio without blocking.",
      "tests": [
        "Tests/AutoTechnoCoreTests/LivePCMQueueTests.swift"
      ]
    },
    {
      "id": "background-live-analysis",
      "name": "Background live analysis",
      "ownerComponent": "live-feedback-coordination-and-inspection",
      "executionContext": "Single bounded background consumer/worker outside the audio callback and MainActor.",
      "allowedWork": "Assemble authenticated windows, analyze owned PCM, derive evidence, and propose one eligible future correction.",
      "forbiddenWork": "Microphone/system capture, current-buffer mutation, unbounded memory/work, UI mutation, or direct commit.",
      "failureBehavior": "Reject incomplete, stale, mismatched, late, or unavailable evidence and preserve the deterministic hold/fallback state.",
      "tests": [
        "Tests/AutoTechnoAppTests/LiveFeedbackCoordinatorTests.swift",
        "Tests/AutoTechnoCoreTests/LiveOutputWindowEvidenceTests.swift"
      ]
    },
    {
      "id": "future-phrase-commit",
      "name": "Future phrase commit",
      "ownerComponent": "macos-transport-and-session-lifecycle",
      "executionContext": "Host-owned control/MainActor boundary before unscheduled audio becomes current.",
      "allowedWork": "Validate exact keys/generations and atomically commit plan, render, graph, quality, live-master, and long-horizon continuation.",
      "forbiddenWork": "Partial state commit, rejected-attempt leakage, scheduled-buffer rewrite, or stale route/session acceptance.",
      "failureBehavior": "Discard stale/unqualified work; preserve accepted PCM or follow the declared deterministic fallback.",
      "tests": [
        "Tests/AutoTechnoAppTests/TechnoEngineLiveFeedbackTests.swift",
        "Tests/AutoTechnoCoreTests/AutonomousCandidateEvaluationTests.swift"
      ]
    },
