    {
      "id": "detached-preparation",
      "name": "Detached preparation",
      "ownerComponent": "shared-detached-preparation",
      "executionContext": "Bounded cancellable non-realtime task before an unscheduled phrase boundary.",
      "allowedWork": "Planning, rendering, analysis, candidate evaluation, deterministic correction, and immutable waveform derivation.",
      "forbiddenWork": "Mutation of scheduled/current PCM, unbounded search, UI work, or direct audio-callback work.",
      "failureBehavior": "Return a reason-coded unavailable/rejected outcome; stale or cancelled work cannot commit.",
