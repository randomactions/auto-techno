      "name": "Windows waveOut completion callback",
      "ownerComponent": "windows-transport-and-waveout",
      "executionContext": "Windows multimedia completion callback.",
      "allowedWork": "Only fixed atomic completion and played-frame counter updates.",
      "forbiddenWork": "Allocation, PCM conversion, cleanup, queue submission, preparation, scheduling, logging, or UI work.",
      "failureBehavior": "Record fixed completion state; non-callback control work performs cleanup or recovery.",
      "tests": [
        "Tests/AutoTechnoCoreTests/CurrentRuntimeTests.swift"
      ]
